# ── Aplicação ──────────────────────────────────────────────
APP_ENV=production
APP_SECRET=troque-por-uma-chave-secreta-forte
LOG_LEVEL=INFO

# ── WhatsApp (Meta API Oficial) ────────────────────────────
META_VERIFY_TOKEN=seu-token-de-verificacao-do-webhook
META_ACCESS_TOKEN=seu-access-token-permanente
META_PHONE_NUMBER_ID=seu-phone-number-id
META_API_VERSION=v20.0

# ── Claude (Anthropic) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
SESSION_TTL_HOURS=48

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=sales_agent
POSTGRES_PASSWORD=senha-forte-aqui
POSTGRES_DB=sales_agent_db
DATABASE_URL=postgresql+asyncpg://sales_agent:senha-forte-aqui@postgres:5432/sales_agent_db

# ── SprintHub (CRM) ────────────────────────────────────────
SPRINTHUB_API_URL=https://api.sprinthub.com.br
SPRINTHUB_API_KEY=sua-api-key-do-sprinthub
SPRINTHUB_PIPELINE_CURSO_1=id-do-pipeline-do-curso-1
SPRINTHUB_PIPELINE_CURSO_2=id-do-pipeline-do-curso-2
SPRINTHUB_PIPELINE_POS_FISIO_NEURO=id-do-pipeline-da-pos-fisio-neuro

# ── Escalação para Humano ──────────────────────────────────
ESCALATION_WHATSAPP_NUMBER=5511999999999

# ── Cursos ─────────────────────────────────────────────────
COURSE_SLUGS=curso_1,curso_2,pos_fisio_neuro
